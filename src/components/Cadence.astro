---
import { aggregates, meta } from '../lib/data.ts';
import { fmtInt, fmtMonthKey, fmtMonthDay } from '../lib/format.ts';

const { byMonth, byWeekdayHour, byLanguage, streaks, peakDay, busiestMonth } = aggregates;
const t = aggregates.totals;

/* ── Monthly commit chart ───────────────────────────────────── */
const VB_W = 660;
const VB_H = 300;
const PAD_L = 38;
const PAD_R = 36;
const PAD_T = 18;
const PAD_B = 30;
const plotW = VB_W - PAD_L - PAD_R;
const plotH = VB_H - PAD_T - PAD_B;

const maxCommits = Math.max(...byMonth.map((m) => m.commits), 1);
const commitStep = maxCommits <= 45 ? 15 : maxCommits <= 75 ? 25 : maxCommits <= 150 ? 50 : 100;
const yMax = Math.ceil(maxCommits / commitStep) * commitStep;
const cumMax =
  [30, 60, 90, 120, 150, 180, 240, 300, 360, 450, 600].find((value) => value >= t.commits) ??
  Math.ceil(t.commits / 100) * 100;

const step = plotW / byMonth.length;
const barW = Math.min(18, step * 0.5);

let running = 0;
const months = byMonth.map((entry, index) => {
  running += entry.commits;
  return {
    ...entry,
    label: fmtMonthKey(entry.month),
    short: entry.month === '2026-01' || entry.month === '2025-11' ? entry.month.replace('-', '.') : entry.month.slice(5),
    cx: PAD_L + index * step + step / 2,
    barX: PAD_L + index * step + (step - barW) / 2,
    barH: (entry.commits / yMax) * plotH,
    barY: PAD_T + plotH - (entry.commits / yMax) * plotH,
    cum: running,
    cumY: PAD_T + plotH - (running / cumMax) * plotH,
  };
});

const gridLines = [0, 1 / 3, 2 / 3, 1].map((ratio) => ({
  y: PAD_T + plotH - ratio * plotH,
  commitLabel: Math.round(yMax * ratio),
  cumLabel: Math.round(cumMax * ratio),
}));

const cumPath = months.map((m, i) => `${i === 0 ? 'M' : 'L'} ${m.cx.toFixed(1)} ${m.cumY.toFixed(1)}`).join(' ');
const peakIndex = months.findIndex((m) => m.month === busiestMonth.month);

/* ── Weekday × hour grid ───────────────────────────────────── */
const WEEKDAY_ORDER = [1, 2, 3, 4, 5, 6, 0];
const WEEKDAY_LABELS = ['一', '二', '三', '四', '五', '六', '日'];
const grid = WEEKDAY_ORDER.map((day) => byWeekdayHour[day]);
const gridMax = Math.max(...grid.flat(), 1);
let peakCell = { weekday: 0, hour: 0, value: 0 };
grid.forEach((row, weekday) => {
  row.forEach((value, hour) => {
    if (value > peakCell.value) peakCell = { weekday, hour, value };
  });
});

const hourlyTotal = grid.flat().reduce((sum, value) => sum + value, 0);

/* ── Languages ─────────────────────────────────────────────── */
const topLanguages = byLanguage.slice(0, 6);
const restLanguages = byLanguage.slice(6);
const restPct = restLanguages.reduce((sum, lang) => sum + lang.pct, 0);

const avgPerActiveDay = meta.counts.daysActive > 0 ? meta.counts.events / meta.counts.daysActive : 0;
---
<section id="cadence" class="section shell" data-chapter="cadence" aria-labelledby="cadence-title">
  <header class="sec-head reveal">
    <div class="sec-head__left">
      <span class="sec-head__index">
        <span class="label">03 / Cadence</span>
        <span class="sec-head__rule" aria-hidden="true"></span>
      </span>
      <h2 id="cadence-title" class="section-heading">节奏</h2>
    </div>
    <p class="sec-head__note note">
      不是均匀的滴答声。某些月份几乎停摆，某些夜晚一口气推完整个功能 —— 这张图保留这种不均匀。
    </p>
  </header>

  <div class="cadence">
    <div class="cadence__main">
      <div class="panel reveal">
      <div class="panel__head">
        <span class="label">Commits by month</span>
        <span class="note">柱形为每月提交 · 细线为累计</span>
      </div>

      <div id="monthly-chart">
        <svg
          viewBox={`0 0 ${VB_W} ${VB_H}`}
          role="img"
          aria-label={`每月提交量，最高 ${maxCommits} 次，总计 ${t.commits} 次提交`}
        >
          {
            gridLines.map((line) => (
              <>
                <line
                  x1={PAD_L}
                  y1={line.y}
                  x2={VB_W - PAD_R}
                  y2={line.y}
                  stroke="var(--rule-soft)"
                  stroke-width="1"
                />
                <text
                  class="chart-axis chart-axis--commit"
                  x={PAD_L - 8}
                  y={line.y + 3}
                  text-anchor="end"
                  fill="var(--muted)"
                  font-family="var(--mono)"
                  font-size="8"
                >
                  {line.commitLabel}
                </text>
                <text
                  class="chart-axis chart-axis--cum"
                  x={VB_W - PAD_R + 8}
                  y={line.y + 3}
                  fill="var(--muted)"
                  font-family="var(--mono)"
                  font-size="8"
                  opacity="0.6"
                >
                  {line.cumLabel}
                </text>
              </>
            ))
          }

          <line
            x1={PAD_L}
            y1={PAD_T + plotH}
            x2={VB_W - PAD_R}
            y2={PAD_T + plotH}
            stroke="var(--rule)"
            stroke-width="1"
          />

          {
            months.map((month, index) => (
              <g class={`bar-col${index === peakIndex ? ' is-peak' : ''}`}>
                <rect
                  class="bar-hit"
                  x={PAD_L + index * step}
                  y={PAD_T}
                  width={step}
                  height={plotH}
                  fill="transparent"
                  data-month={month.label}
                  data-commits={month.commits}
                  data-additions={month.additions}
                  data-deletions={month.deletions}
                />
                <rect
                  class="bar"
                  x={month.barX}
                  y={month.barY}
                  width={barW}
                  height={Math.max(month.barH, month.commits > 0 ? 1 : 0)}
                  fill={index === peakIndex ? 'var(--accent)' : 'rgba(232,162,74,0.62)'}
                />
                <text
                  x={month.cx}
                  y={VB_H - 10}
                  text-anchor="middle"
                  fill="var(--muted)"
                  font-family="var(--mono)"
                  font-size="8.5"
                >
                  {month.short}
                </text>
              </g>
            ))
          }

          <path class="cum-line" d={cumPath} fill="none" stroke="var(--accent2)" stroke-width="1.25" opacity="0.8" />

          {
            peakIndex >= 0 && (
              <text
                x={months[peakIndex].cx}
                y={months[peakIndex].barY - 6}
                text-anchor="middle"
                fill="var(--accent)"
                font-family="var(--mono)"
                font-size="8.5"
              >
                {maxCommits}
              </text>
            )
          }
        </svg>
      </div>

      <div class="note" style="margin-top:10px">
        左轴：每月提交量 · 右轴：累计提交量 · 最后一个月份为快照当月的进行中数据
      </div>
      </div>

      <div class="panel reveal" style="--delay:200ms">
        <div class="panel__head">
          <span class="label">Languages</span>
          <span class="note">按仓库字节数</span>
        </div>
        <div class="lang-bar" aria-hidden="true">
          {
            topLanguages.map((lang) => (
              <i style={`width:${(lang.pct * 100).toFixed(2)}%;background:${lang.color ?? 'var(--rule)'}`} />
            ))
          }
          {restPct > 0 && <i style={`width:${(restPct * 100).toFixed(2)}%;background:var(--rule)`} />}
        </div>
        <div class="lang-list">
          {
            topLanguages.map((lang) => (
              <div class="lang-row">
                <span class="lang-row__dot" style={`background:${lang.color ?? 'var(--rule)'}`} />
                <span class="lang-row__name">{lang.name}</span>
                <span>{(lang.pct * 100).toFixed(1)}%</span>
              </div>
            ))
          }
          {
            restPct > 0 && (
              <div class="lang-row">
                <span class="lang-row__dot" style="background:var(--rule)" />
                <span class="lang-row__name">其他 {restLanguages.length} 种</span>
                <span>{(restPct * 100).toFixed(1)}%</span>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <aside class="cadence__aside">
      <div class="panel reveal" style="--delay:80ms">
        <div class="panel__head">
          <span class="label">Weekday × Hour</span>
          <span class="note">北京时间 · {fmtInt(hourlyTotal)} 次提交</span>
        </div>
        <div
          class="hourgrid"
          role="img"
          aria-label={`按星期与小时分布的 ${hourlyTotal} 次提交，峰值出现在周${WEEKDAY_LABELS[peakCell.weekday]} ${peakCell.hour} 点`}
        >
          {
            grid.map((row, weekday) => (
              <>
                <span class="hourgrid__label">{WEEKDAY_LABELS[weekday]}</span>
                {row.map((value, hour) => (
                  <span
                    class="hourgrid__cell"
                    style={`background:rgba(232,162,74,${(0.05 + (value / gridMax) * 0.78).toFixed(3)})`}
                    title={`周${WEEKDAY_LABELS[weekday]} ${String(hour).padStart(2, '0')}:00 · ${value} 次`}
                  />
                ))}
              </>
            ))
          }
        </div>
        <div class="hourgrid__axis" aria-hidden="true">
          <span></span>
          {Array.from({ length: 24 }, (_, hour) => (
            <span>{[0, 6, 12, 18].includes(hour) ? String(hour).padStart(2, '0') : ''}</span>
          ))}
        </div>
        <div class="note" style="margin-top:12px">
          最密集的一格是周{WEEKDAY_LABELS[peakCell.weekday]} {String(peakCell.hour).padStart(2, '0')}:00，
          累计 {peakCell.value} 次提交。
        </div>
      </div>

      <div class="reveal" style="--delay:140ms">
        <div class="stat-list">
          <div class="stat">
            <span class="stat__k">最长连续</span>
            <span class="stat__v"
              >{streaks.longest} <small>天 · {fmtMonthDay(`${streaks.longestStart}T00:00:00Z`)}–{fmtMonthDay(
                `${streaks.longestEnd}T00:00:00Z`,
              )}</small></span
            >
          </div>
          <div class="stat">
            <span class="stat__k">当前连续</span>
            <span class="stat__v">{streaks.current} <small>天</small></span>
          </div>
          <div class="stat">
            <span class="stat__k">单日峰值</span>
            <span class="stat__v"
              >{peakDay.events} <small>条记录 · {fmtMonthDay(`${peakDay.date}T00:00:00Z`)}</small></span
            >
          </div>
          <div class="stat">
            <span class="stat__k">最忙的月份</span>
            <span class="stat__v"
              >{busiestMonth.commits} <small>commits · {fmtMonthKey(busiestMonth.month)}</small></span
            >
          </div>
          <div class="stat">
            <span class="stat__k">活跃日</span>
            <span class="stat__v"
              >{meta.counts.daysActive} <small>/ 350 天 · 平均 {avgPerActiveDay.toFixed(1)} 条</small></span
            >
          </div>
        </div>
      </div>
    </aside>
  </div>

  <div class="tip" id="chart-tip" role="status" aria-live="polite"></div>
</section>

<script>
  const chart = document.getElementById('monthly-chart');
  const tip = document.getElementById('chart-tip');
  if (chart && tip) {
    const fmt = new Intl.NumberFormat('en-US');
    const show = (hit: SVGRectElement) => {
      const month = hit.dataset.month ?? '';
      const commits = Number(hit.dataset.commits ?? '0');
      const additions = Number(hit.dataset.additions ?? '0');
      const deletions = Number(hit.dataset.deletions ?? '0');
      tip.textContent =
        commits === 0
          ? `${month.replace('-', '.')} · 没有提交`
          : `${month.replace('-', '.')} · ${commits} commits · +${fmt.format(additions)} / −${fmt.format(deletions)}`;
      const box = hit.getBoundingClientRect();
      tip.style.left = `${box.left + box.width / 2}px`;
      tip.style.top = `${box.top + box.height * 0.35}px`;
      tip.classList.add('is-on');
    };
    const hide = () => tip.classList.remove('is-on');

    chart.querySelectorAll<SVGRectElement>('.bar-hit').forEach((hit) => {
      hit.addEventListener('pointerenter', () => show(hit));
      hit.addEventListener('pointerleave', hide);
    });
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>
