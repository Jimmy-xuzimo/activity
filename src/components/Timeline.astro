---
import { events } from '../lib/data.ts';
const payload = JSON.stringify(events.map(({ ts, title, repoName, url, type }) => ({ ts, title, repoName, url, type }))).replace(/</g, '\\u003c');
---
<div class="time-explorer" data-timeline>
  <div class="time-toolbar">
    <span class="time-range" aria-live="polite"></span>
    <div class="time-controls">
      <button type="button" data-time="out" aria-label="Zoom out">−</button>
      <button type="button" data-time="in" aria-label="Zoom in">+</button>
      <button type="button" data-time="reset" aria-label="Reset timeline">↺</button>
    </div>
  </div>
  <p class="time-help note"></p>
  <div class="time-viewport" tabindex="0" role="group" aria-label="Interactive activity timeline">
    <svg class="time-svg" height="220" aria-hidden="true"></svg>
    <div class="time-points"></div>
  </div>
  <div class="time-selection" aria-live="polite"></div>
  <div class="time-events"></div>
  <script type="application/json" id="time-data" set:html={payload}></script>
</div>
<script src="../lib/timeline.ts"></script>
