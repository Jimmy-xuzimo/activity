{
  "name": "activity",
  "version": "1.0.0",
  "description": "A static archive of my GitHub activity, built with Astro.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "node scripts/sync.ts --mode=incremental",
    "backfill": "node scripts/sync.ts --mode=backfill",
    "validate": "node scripts/validate.ts"
  },
  "dependencies": {
    "astro": "^7.4.7"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
